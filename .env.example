# Copy this file to .env and put your own key in it:
#   Windows:       copy .env.example .env
#   macOS/Linux:   cp .env.example .env
# .env is ignored by git, so your key is never uploaded.

# REQUIRED for the chat agent (python main.py and the "Ask Uzhavan" page).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here

# ---- Optional settings (remove the # to use one) ----

# Gemini model to use (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Use Groq instead of Gemini: set a Groq key and AGENTX_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# AGENTX_PROVIDER=gemini

# Port for python server.py (default 8000). If you change it, also change the
# /api proxy target in vite.config.ts.
# PORT=8000

# Folder where farms and their sensor files are saved (default: .farmdata)
# AGENTX_FARM_DIR=.farmdata

# Websites allowed to call the API from a browser (default: all)
# AGENTX_CORS_ORIGINS=*

# Run the agent with a scripted LLM, no key needed (same as --dry-run)
# AGENTX_DRY_RUN=1
